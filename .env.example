# verifyEngr settings — TEMPLATE
# 1. Copy this file and rename the copy to ".env"
# 2. Fill in your own values
# 3. Never share or upload your .env file

# ---- General ----
# The name shown on the website
SITE_NAME=verifyEngr

# Where the engineer data comes from: "sample" for the hackathon, "live" later
DATA_SOURCE=sample

# ---- Supabase (the database) ----
# The website itself reads these from website/js/config.js.
# The publishable key is safe in the browser. The secret key is NOT:
# keep it only here in your private .env, never in website files.
SUPABASE_URL=https://jghbrbkorzwmjvnvfrav.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ---- COREN (fill in after the partnership is agreed) ----
COREN_API_URL=
COREN_API_KEY=

# ---- NSE (fill in after the partnership is agreed) ----
NSE_API_URL=
NSE_API_KEY=

# ---- Contact ----
# Email shown for "Report a problem"
